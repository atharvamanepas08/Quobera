# MoneyGuru Environment Configuration
# Copy this file to .env and adjust the values before running the application.

# Server Port (default: 4000)
PORT=4000

# Secret key used for signing and verifying HMAC-SHA256 authentication tokens.
# REQUIRED: Replace with a secure, random string (e.g., minimum 32 characters).
JWT_SECRET=replace_with_a_secure_random_jwt_secret_32chars

# Secret key required to access administrative API endpoints (?key=<ADMIN_KEY>).
# REQUIRED: Replace with a private admin token.
ADMIN_KEY=replace_with_a_secure_admin_key_here

# Allowed CORS origin for client access (default: * for local development)
CORS_ORIGIN=*
